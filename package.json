{
  "name": "opencode-slack-bridge",
  "version": "1.0.0",
  "description": "Bridge opencode agent sessions to Slack: approval/question cards, status reactions, reply injection.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@slack/web-api": "^7.0.0",
    "@slack/socket-mode": "^2.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.33",
    "@opencode-ai/sdk": "1.18.33",
    "@slack/types": "^2.0.0",
    "@types/node": "24.12.2",
    "esbuild": "^0.25.0",
    "typescript": "5.8.2"
  }
}
